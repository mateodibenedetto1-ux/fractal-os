# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor. Nunca la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL pública de la app (para invitaciones y webhooks)
NEXT_PUBLIC_APP_URL=https://tu-app.vercel.app

# --- Opcional: Claude procesa cada llamada de Fathom (resumen en español + accionables + recursos) ---
# Sin esta clave se usan el resumen y los action items que manda Fathom (vienen en inglés).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Opcional: importación desde Notion (npm run import:notion) ---
NOTION_TOKEN=
